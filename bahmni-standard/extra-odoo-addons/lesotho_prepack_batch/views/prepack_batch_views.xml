<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bahmni_prepack_batch_tree" model="ir.ui.view">
        <field name="name">bahmni.prepack.batch.tree</field>
        <field name="model">bahmni.prepack.batch</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-warning="state == 'pending_auth'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="planned_date"/>
                <field name="responsible_id"/>
                <field name="line_count"/>
                <field name="mrp_production_count"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pending_auth'" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_bahmni_prepack_batch_form" model="ir.ui.view">
        <field name="name">bahmni.prepack.batch.form</field>
        <field name="model">bahmni.prepack.batch</field>
        <field name="arch" type="xml">
            <form string="Prepack Batch">
                <header>
                    <button name="action_authorize_batch" string="Authorize" type="object" class="btn-primary" states="pending_auth" groups="mrp.group_mrp_manager"/>
                    <button name="action_print_prepack_labels" string="Print Labels" type="object" class="btn-primary" states="done"/>
                    <button name="action_record_damaged_products" string="Record Damaged Products" type="object" class="btn-secondary" attrs="{'invisible': ['|', ('has_damaged_products', '=', False), ('state', 'not in', ('draft', 'rejected'))]}"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,pending_auth"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_auth,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_manufacturing_orders" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="mrp_production_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="planned_date"/>
                            <field name="responsible_id"/>
                            <field name="has_damaged_products"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="picking_type_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prepack Lines">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="parent_elmis_product_id" optional="show"/>
                                    <field name="bulk_lot_id"/>
                                    <field name="source_elmis_lot_number" optional="show"/>
                                    <field name="package_qty"/>
                                    <field name="component_required_qty"/>
                                    <field name="finished_lot_id"/>
                                    <field name="product_barcode"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Details">
                            <group>
                                <field name="location_src_id"/>
                                <field name="location_dest_id"/>
                            </group>
                        </page>
                        <page string="Damage Records" attrs="{'invisible': [('has_damaged_products', '=', False)]}">
                            <field name="damage_scrap_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="scrap_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="location_id"/>
                                    <field name="scrap_location_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                            <field name="damage_move_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Add internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_prepack_damage_wizard_form" model="ir.ui.view">
        <field name="name">prepack.damage.wizard.form</field>
        <field name="model">prepack.damage.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Damaged Products">
                <sheet>
                    <group>
                        <field name="damage_reason" placeholder="Describe how the product was damaged."/>
                    </group>
                    <group>
                        <field name="prepack_job_id"/>
                        <field name="available_product_ids" invisible="1"/>
                        <field name="product_id"/>
                        <field name="damaged_qty"/>
                        <field name="unserviceable_location_id"/>
                        <field name="available_elmis_program_ids" invisible="1"/>
                        <field name="elmis_program_id" attrs="{'invisible': [('product_id', '=', False)]}"/>
                        <field name="elmis_adjustment_reason" attrs="{'invisible': [('product_id', '=', False)]}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_damage" string="Confirm Damage" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bahmni_prepack_batch_history" model="ir.actions.act_window">
        <field name="name">Prepacking History</field>
        <field name="res_model">bahmni.prepack.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No prepack history found.
            </p>
            <p>
                All prepack batches created through the dashboard will appear here.
            </p>
        </field>
    </record>

    <record id="action_bahmni_prepack_products" model="ir.actions.act_window">
        <field name="name">Prepacked Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_prepack', '=', True)]</field>
        <field name="context">{'default_is_prepack': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No prepacked products found.
            </p>
            <p>
                Products created through the prepacking workflow will be listed here.
            </p>
        </field>
    </record>

    <record id="lesotho_base.action_create_prepacks_placeholder" model="ir.actions.client">
        <field name="name">Create Prepacks</field>
        <field name="tag">prepack_dashboard_client_action</field>
        <field name="target">current</field>
        <field name="context">{'mode': 'create'}</field>
    </record>

    <record id="lesotho_base.action_authorise_prepacks_placeholder" model="ir.actions.client">
        <field name="name">Authorise Prepacks</field>
        <field name="tag">prepack_dashboard_client_action</field>
        <field name="target">current</field>
        <field name="context">{'mode': 'authorize'}</field>
    </record>

    <record id="lesotho_base.action_view_prepacks_placeholder" model="ir.actions.client">
        <field name="name">View Prepacks</field>
        <field name="tag">prepack_dashboard_client_action</field>
        <field name="target">current</field>
        <field name="context">{'mode': 'history'}</field>
    </record>

    <record id="action_prepack_dashboard_client_v3" model="ir.actions.client">
        <field name="name">Prepack Dashboard</field>
        <field name="tag">prepack_dashboard_client_action</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_bahmni_prepack_batch_history"
        name="Prepacking History"
        parent="mrp.menu_mrp_root"
        action="action_bahmni_prepack_batch_history"
        sequence="20"
    />

    <menuitem
        id="menu_bahmni_prepack_products"
        name="Prepacked Products"
        parent="mrp.menu_mrp_root"
        action="action_bahmni_prepack_products"
        sequence="25"
    />
</odoo>
