<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <function model="ir.model.data" name="write">
      <function model="ir.model.data" name="search">
        <value eval="[('module', '=', 'base'), ('name', 'in', ['user_root', 'partner_root'])]"/>
      </function>
      <value eval="{'noupdate': False}"/>
    </function>

    <record id="base.user_root" model="res.users">
      <field name="name">DispensingBot</field>
    </record>

    <record id="base.partner_root" model="res.partner">
      <field name="name">DispensingBot</field>
    </record>

    <function model="ir.model.data" name="write">
      <function model="ir.model.data" name="search">
        <value eval="[('module', '=', 'base'), ('name', 'in', ['user_root', 'partner_root'])]"/>
      </function>
      <value eval="{'noupdate': True}"/>
    </function>
  </data>
</odoo>
