<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_lot_form_elmis_integration" model="ir.ui.view">
        <field name="name">stock.lot.form.elmis.integration</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="elmis_lot_id"/>
                <field name="elmis_lot_number"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_tree_elmis_integration" model="ir.ui.view">
        <field name="name">stock.lot.tree.elmis.integration</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="elmis_lot_number" optional="show"/>
                <field name="elmis_lot_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
