<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="elmis_inventory_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">elmis.inventory.sync.wizard.view.form</field>
        <field name="model">elmis.inventory.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Trigger eLMIS Sync">
                <sheet>
                    <group>
                        <field name="mirror_location_id"/>
                        <field name="facility_code"/>
                        <field name="program_codes"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_sync_inventory" type="object" string="Sync Inventory Now" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_elmis_inventory_sync_wizard" model="ir.actions.act_window">
        <field name="name">Trigger eLMIS Sync</field>
        <field name="res_model">elmis.inventory.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_elmis_inventory_sync_wizard"
        name="Trigger eLMIS Sync"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_elmis_inventory_sync_wizard"
        sequence="80"
        groups="stock.group_stock_manager"/>
</odoo>
