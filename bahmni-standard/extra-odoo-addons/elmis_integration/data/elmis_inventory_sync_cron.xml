<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_elmis_inventory_sync" model="ir.cron">
        <field name="name">eLMIS Inventory Sync</field>
        <field name="model_id" ref="model_elmis_inventory_sync"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_configured_facility_inventory()</field>
        <field name="active" eval="False"/>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_elmis_outbox_drain" model="ir.cron">
        <field name="name">eLMIS Outbox Submission</field>
        <field name="model_id" ref="model_elmis_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_drain_pending_to_elmis()</field>
        <field name="active" eval="False"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>
