<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dispensed_prescription" model="ir.actions.report">
        <field name="name">Dispensed Prescription</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lesotho_sale.report_dispensed_prescription</field>
        <field name="report_file">lesotho_sale.report_dispensed_prescription</field>
        <field name="print_report_name">'Dispensed Prescription - %s' % (object.name)</field>
    </record>

    <template id="report_dispensed_prescription">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Dispensed Prescription</h2>
                        <p>
                            <strong>Patient:</strong>
                            <span t-field="doc.partner_id"/>
                            <br/>
                            <strong>Prescription Date:</strong>
                            <span t-field="doc.date_order"/>
                            <br/>
                            <strong>Prescriber:</strong>
                            <span t-esc="doc.provider_name or ''"/>
                            <br/>
                            <strong>Dispensary:</strong>
                            <span t-field="doc.shop_id"/>
                        </p>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Dispensed Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Batch Number</th>
                                    <th>Directions of Use</th>
                                    <th>Additional Instructions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr t-if="not line.display_type and line.dispensed">
                                        <td>
                                            <span t-field="line.product_id"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.dispensing_batch_number or ''"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.administration_instructions or line.full_prescription_text or ''"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.additional_instructions or ''"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
