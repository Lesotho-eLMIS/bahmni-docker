<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_prescription_labels" model="report.paperformat">
        <field name="name">Prescription Labels</field>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">70</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_prescription_labels" model="ir.actions.report">
        <field name="name">Prescription Labels</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lesotho_sale.report_prescription_labels</field>
        <field name="report_file">lesotho_sale.report_prescription_labels</field>
        <field name="print_report_name">'Prescription Labels - %s' % (object.name)</field>
        <field name="paperformat_id" ref="lesotho_sale.paperformat_prescription_labels"/>
    </record>

    <template id="report_prescription_labels">
        <t t-call="web.html_container">
            <style>
                .o_prescription_label_page {
                    font-family: "Courier New", Courier, monospace;
                    color: #111;
                    page-break-after: always;
                }

                .o_prescription_label {
                    padding: 3mm;
                    border: 1px solid #111;
                }

                .o_prescription_label_facility {
                    font-size: 12px;
                    font-weight: 700;
                    text-transform: uppercase;
                    line-height: 1.15;
                }

                .o_prescription_label_address {
                    font-size: 9px;
                    font-weight: 700;
                    line-height: 1.2;
                }

                .o_prescription_label_separator {
                    border-top: 1px solid #111;
                    margin: 4px 0;
                }

                .o_prescription_label_product {
                    display: flex;
                    justify-content: space-between;
                    gap: 12px;
                    font-size: 12px;
                    font-weight: 700;
                    margin-bottom: 4px;
                }

                .o_prescription_label_directions {
                    min-height: 12mm;
                    font-size: 11px;
                    font-weight: 700;
                    line-height: 1.4;
                    text-transform: uppercase;
                    white-space: pre-line;
                    margin-bottom: 3px;
                }

                .o_prescription_label_directions strong {
                    display: block;
                    margin-bottom: 1px;
                }

                .o_prescription_label_meta {
                    font-size: 9px;
                    font-weight: 700;
                    line-height: 1.35;
                    margin-bottom: 3px;
                }

                .o_prescription_label_footer {
                    margin-top: 2px;
                    font-size: 10px;
                    font-weight: 700;
                    line-height: 1.3;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-set="facility_name" t-value="doc._get_prescription_label_facility_name()"/>
                <t t-set="facility_address_lines" t-value="doc._get_prescription_label_address_lines()"/>
                <t t-set="dispenser_name" t-value="env.user.display_name or ''"/>
                <t t-foreach="doc._get_dispensing_label_items()" t-as="label_item">
                    <div class="page o_prescription_label_page">
                        <div class="o_prescription_label">
                            <div class="o_prescription_label_facility">
                                <t t-esc="facility_name"/>
                            </div>
                            <t t-foreach="facility_address_lines" t-as="address_line">
                                <div class="o_prescription_label_address">
                                    <t t-esc="address_line"/>
                                </div>
                            </t>
                            <div class="o_prescription_label_separator"/>

                            <div class="o_prescription_label_product">
                                <span><t t-esc="label_item.get('product_name') or ''"/></span>
                                <span>
                                    <t t-esc="label_item.get('quantity') or 0"/>
                                    <t t-esc="label_item.get('uom_name') or ''"/>
                                </span>
                            </div>

                            <div class="o_prescription_label_directions">
                                <strong>Dosage Instructions</strong>
                                <t t-esc="label_item.get('directions') or ''"/>
                            </div>

                            <div class="o_prescription_label_meta">
                                <div>
                                    <strong>Batch Number:</strong>
                                    <span t-esc="label_item.get('batch_number') or ''"/>
                                </div>
                                <div>
                                    <strong>Expiry Date:</strong>
                                    <span t-esc="label_item.get('expiry_date') or ''"/>
                                </div>
                            </div>

                            <div class="o_prescription_label_footer">
                                <div>
                                    <strong>Rx:</strong>
                                    <span t-esc="doc.name"/>
                                    <t t-if="doc.provider_name">
                                        <span> - </span>
                                        <span t-esc="doc.provider_name"/>
                                    </t>
                                </div>
                                <div>
                                    <strong>Patient:</strong>
                                    <span t-esc="doc.partner_id.display_name"/>
                                </div>
                                <div>
                                    <strong>Dispensed By:</strong>
                                    <span t-esc="dispenser_name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
