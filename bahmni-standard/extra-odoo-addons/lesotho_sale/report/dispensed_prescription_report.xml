<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_prescription_labels" model="report.paperformat">
        <field name="name">Prescription Labels</field>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">70</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_prescription_labels" model="ir.actions.report">
        <field name="name">Prescription Labels</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lesotho_sale.report_prescription_labels</field>
        <field name="report_file">lesotho_sale.report_prescription_labels</field>
        <field name="print_report_name">'Prescription Labels - %s' % (object.name)</field>
        <field name="paperformat_id" ref="lesotho_sale.paperformat_prescription_labels"/>
    </record>

    <template id="report_prescription_labels">
        <t t-call="web.html_container">
            <style>
                @page {
                    size: 100mm 70mm;
                    margin: 2mm;
                }

                .o_prescription_label_page {
                    width: 96mm;
                    height: 66mm;
                    padding: 0;
                    margin: 0;
                    font-family: Arial, sans-serif;
                    color: #111;
                    page-break-inside: avoid;
                }

                .o_prescription_label {
                    width: 94mm;
                    height: 64mm;
                    padding: 2.5mm 3.5mm;
                    border: 1.2mm solid #129bd3;
                    border-radius: 4mm;
                    box-sizing: border-box;
                    overflow: hidden;
                }

                .o_prescription_label h3 {
                    margin: 0 0 1.2mm;
                    padding-bottom: 0.8mm;
                    border-bottom: 0.3mm solid #111;
                    font-size: 11px;
                    font-weight: 800;
                    line-height: 1.1;
                    text-align: center;
                    text-transform: uppercase;
                }

                .o_prescription_label_facility {
                    margin-bottom: 0.6mm;
                    font-size: 8px;
                    font-weight: 800;
                    line-height: 1.15;
                    white-space: nowrap;
                }

                .o_prescription_label_address {
                    font-size: 7px;
                    font-weight: 700;
                    line-height: 1.1;
                }

                .o_prescription_label_product {
                    margin: 1mm 0;
                    font-size: 8.5px;
                    font-weight: 700;
                    line-height: 1.2;
                }

                .o_prescription_label_product_name {
                    display: inline-block;
                    width: 70mm;
                    vertical-align: top;
                }

                .o_prescription_label_quantity {
                    display: inline-block;
                    width: 15mm;
                    text-align: right;
                    vertical-align: top;
                    white-space: nowrap;
                }

                .o_prescription_label_directions {
                    min-height: 20mm;
                    margin-bottom: 1mm;
                    padding: 1mm 1.5mm;
                    background: #eef8fc;
                    border-left: 1mm solid #129bd3;
                    font-size: 8px;
                    font-weight: 700;
                    line-height: 1.25;
                }

                .o_prescription_label_directions_title {
                    margin-bottom: 0.6mm;
                    font-size: 8.5px;
                    font-weight: 800;
                    text-transform: uppercase;
                }

                .o_prescription_label_direction {
                    margin-bottom: 0.5mm;
                }

                .o_prescription_label_language {
                    display: inline-block;
                    min-width: 13mm;
                    font-weight: 800;
                }

                .o_prescription_label_meta {
                    display: table;
                    width: 100%;
                    font-size: 7.5px;
                    font-weight: 700;
                    line-height: 1.2;
                }

                .o_prescription_label_meta > div {
                    display: table-cell;
                    width: 50%;
                }

                .o_prescription_label_footer {
                    margin-top: 1mm;
                    padding-top: 0.8mm;
                    border-top: 0.2mm solid #777;
                    font-size: 7.5px;
                    font-weight: 700;
                    line-height: 1.2;
                }

                .o_prescription_label_footer_row {
                    display: table;
                    width: 100%;
                }

                .o_prescription_label_footer_row > span {
                    display: table-cell;
                    width: 50%;
                }

                .o_prescription_label_footer_row > span:last-child {
                    text-align: right;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-set="facility_name" t-value="doc._get_prescription_label_facility_name()"/>
                <t t-set="facility_address_lines" t-value="doc._get_prescription_label_address_lines()"/>
                <t t-set="dispenser_name" t-value="env.user.display_name or ''"/>
                <t t-foreach="doc._get_dispensing_label_items()" t-as="label_item">
                    <div class="page o_prescription_label_page" t-att-style="'page-break-after: auto;' if label_item_last else 'page-break-after: always;'">
                        <div class="o_prescription_label">
                            <h3>Prescription Label</h3>
                            <div class="o_prescription_label_facility">
                                <strong>Facility:</strong>
                                <t t-esc="facility_name"/>
                            </div>
                            <t t-foreach="facility_address_lines" t-as="address_line">
                                <div class="o_prescription_label_address">
                                    <t t-esc="address_line"/>
                                </div>
                            </t>
                            <div class="o_prescription_label_product">
                                <span class="o_prescription_label_product_name"><t t-esc="label_item.get('product_name') or ''"/></span>
                                <span class="o_prescription_label_quantity">
                                    <t t-esc="doc._format_prescription_label_quantity(label_item.get('quantity'))"/>
                                    <t t-esc="label_item.get('uom_name') or ''"/>
                                </span>
                            </div>

                            <div class="o_prescription_label_directions">
                                <div class="o_prescription_label_directions_title">Instructions / Litaelo</div>
                                <div class="o_prescription_label_direction">
                                    <span class="o_prescription_label_language">English:</span>
                                    <span t-esc="label_item.get('directions') or ''"/>
                                </div>
                                <div class="o_prescription_label_direction">
                                    <span class="o_prescription_label_language">Sesotho:</span>
                                    <span t-esc="label_item.get('directions_sesotho') or ''"/>
                                </div>
                            </div>

                            <div class="o_prescription_label_meta">
                                <div>
                                    <strong>Batch Number:</strong>
                                    <span t-esc="label_item.get('batch_number') or ''"/>
                                </div>
                                <div>
                                    <strong>Expiry Date:</strong>
                                    <span t-esc="label_item.get('expiry_date') or ''"/>
                                </div>
                            </div>

                            <div class="o_prescription_label_footer">
                                <div class="o_prescription_label_footer_row">
                                    <span><strong>Rx:</strong> <t t-esc="doc.name"/></span>
                                    <span><strong>Patient:</strong> <t t-esc="doc.partner_id.display_name"/></span>
                                </div>
                                <div class="o_prescription_label_footer_row">
                                    <span><strong>Dispensed By:</strong> <t t-esc="dispenser_name"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
