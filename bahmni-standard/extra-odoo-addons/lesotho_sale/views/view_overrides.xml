<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_age_sex" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.age.sex</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <!-- Insert the fields after the name field -->
                <xpath expr="//field[@name='phone']" position="after">
                    <group>
                        <field name='sex' />
                        <field name='age' />
                        <field name='weight' />
                        <field name='height' />
                        <field name='diastolic' />
                        <field name='systolic' />
                    </group>
                </xpath>
            </field>
        </record>

         <record id="sale_order_tree_remove_onboarding" model="ir.ui.view">
            <field name="name">sale.order.tree.remove.onboarding</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">

                <!-- Remove onboarding banner -->
                <xpath expr="//tree" position="attributes">
                    <attribute name="banner_route"/>
                </xpath>

            </field>
        </record>

         <record id="sale_order_tree_remove_help" model="ir.ui.view">
            <field name="name">sale.order.tree.remove.help</field> 
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">

                <!-- Remove help (this removes smiling doc + text) -->
                <xpath expr="//tree" position="attributes">
                    <attribute name="help"/>
                </xpath>

            </field>
        </record>
        

        <!-- Disable the onboarding panel by overriding it with empty content -->
        <!-- <template
      id="sale_quotation_onboarding_panel"
      inherit_id="sale.sale_quotation_onboarding_panel"
    >
            <xpath expr="." position="replace">
            </xpath>
        </template> -->
    </data>
</odoo>
