<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_product_form_elmis_integration" model="ir.ui.view">
        <field name="name">product.product.form.elmis.integration</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="eLMIS Information">
                    <group>
                        <field name="is_prepack" invisible="1"/>
                        <field name="is_elmis_product"/>
                        <field name="elmis_orderable_id" attrs="{'required': [('is_elmis_product', '=', True)]}"/>
                        <field name="elmis_product_code"/>
                        <field name="elmis_program_ids" widget="many2many_tags"/>
                        <field name="openmrs_concept_uuid"/>
                        <field name="openmrs_concept_code"/>
                        <field name="elmis_generic_name"/>
                        <field name="elmis_strength"/>
                    </group>
                    <group>
                        <field
                            name="prepack_parent_elmis_product_id"
                            attrs="{'invisible': [('is_prepack', '=', False)]}"
                        />
                        <field
                            name="prepack_parent_bulk_uom_id"
                            attrs="{'invisible': [('is_prepack', '=', False)]}"
                            readonly="1"
                        />
                        <field name="elmis_dosage_form"/>
                        <field name="elmis_pack_size"/>
                        <field name="elmis_pack_size_unit"/>
                        <field name="elmis_dispensable_unit"/>
                        <field name="elmis_dispensable_unit_factor"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_tree_elmis_integration" model="ir.ui.view">
        <field name="name">product.product.tree.elmis.integration</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="is_elmis_product" optional="hide"/>
                <field name="elmis_product_code" optional="show"/>
                <field name="elmis_program_ids" widget="many2many_tags" optional="show"/>
                <field name="elmis_orderable_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_search_elmis_integration" model="ir.ui.view">
        <field name="name">product.product.search.elmis.integration</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="elmis_program_ids" string="eLMIS Program"/>
            </xpath>
            <xpath expr="//filter[@name='services']" position="after">
                <filter name="elmis_products" string="eLMIS Products" domain="[('is_elmis_product', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_prepack_elmis_lineage" model="ir.ui.view">
        <field name="name">product.template.form.prepack.elmis.lineage</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="lesotho_base.view_product_template_form_add_prepack"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pack_unit_qty']" position="after">
                <field
                    name="prepack_parent_elmis_product_id"
                    attrs="{'invisible': [('is_dispensing_pack', '=', False)]}"
                />
                <field
                    name="prepack_parent_bulk_uom_id"
                    attrs="{'invisible': [('is_dispensing_pack', '=', False)]}"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
