<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_scrap_form_view_elmis_integration" model="ir.ui.view">
        <field name="name">stock.scrap.form.elmis.integration</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scrap_location_id']" position="after">
                <field name="elmis_program_id" attrs="{'invisible': [('product_id', '=', False)]}"/>
                <field name="elmis_adjustment_reason" attrs="{'invisible': [('product_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="stock_scrap_tree_view_elmis_integration" model="ir.ui.view">
        <field name="name">stock.scrap.tree.elmis.integration</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scrap_location_id']" position="after">
                <field name="elmis_program_id" optional="hide"/>
                <field name="elmis_adjustment_reason" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
