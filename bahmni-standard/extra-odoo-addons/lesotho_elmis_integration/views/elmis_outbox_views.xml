<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="elmis_outbox_view_tree" model="ir.ui.view">
        <field name="name">elmis.outbox.view.tree</field>
        <field name="model">elmis.outbox</field>
        <field name="arch" type="xml">
            <tree string="Integration Events" create="false" edit="false" delete="false"
                  class="o_elmis_workspace_list o_elmis_integration_event_list"
                  decoration-success="status == 'DELIVERED'"
                  decoration-warning="status in ['PENDING', 'SENT']"
                  decoration-danger="status in ['FAILED', 'DLQ']">
                <field name="created_at" string="Created"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'DELIVERED'"
                       decoration-warning="status in ['PENDING', 'SENT']"
                       decoration-danger="status in ['FAILED', 'DLQ']"/>
                <field name="consumption_mode" optional="hide"/>
                <field name="transaction_type" string="Type"/>
                <field name="event_source_label" string="Workflow"/>
                <field name="movement_side_label" string="Movement"/>
                <field name="facility_code" string="Facility"/>
                <field name="program_id"/>
                <field name="elmis_orderable_id" string="Product"/>
                <field name="lot_id" string="Batch"/>
                <field name="quantity"/>
                <field name="dispensed_product_id" optional="hide"/>
                <field name="dispensed_lot_id" optional="hide"/>
                <field name="dispensed_quantity" optional="hide"/>
                <field name="adjustment_reason" string="Reason"/>
                <field name="stock_scrap_side" optional="hide"/>
                <field name="stock_move_line_side" optional="hide"/>
                <field name="attempt_count" string="Attempts"/>
                <field name="sent_at" optional="hide"/>
                <field name="delivered_at" string="Delivered" optional="show"/>
                <field name="message_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="elmis_outbox_view_form" model="ir.ui.view">
        <field name="name">elmis.outbox.view.form</field>
        <field name="model">elmis.outbox</field>
        <field name="arch" type="xml">
            <form string="Integration Event" create="false" edit="false" delete="false"
                  class="o_elmis_workspace_form o_elmis_integration_event_form">
                <header>
                    <button
                        name="action_submit_to_elmis"
                        type="object"
                        string="Submit to eLMIS"
                        class="btn-primary"
                        attrs="{'invisible': [('status', 'in', ['DELIVERED', 'DLQ'])]}"/>
                    <button
                        name="action_reset_to_pending"
                        type="object"
                        string="Reopen for Retry"
                        class="btn-secondary"
                        attrs="{'invisible': [('status', 'not in', ['FAILED', 'DLQ', 'SENT'])]}"/>
                    <button
                        name="action_mark_dlq"
                        type="object"
                        string="Move to DLQ"
                        class="btn-secondary"
                        attrs="{'invisible': [('status', 'not in', ['FAILED', 'PENDING', 'SENT'])]}"/>
                    <field name="status" widget="statusbar" statusbar_visible="PENDING,SENT,DELIVERED,FAILED,DLQ"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="message_id" string="Integration Event"/>
                        <h1><field name="message_id" readonly="1"/></h1>
                    </div>
                    <group string="eLMIS Transaction">
                        <group>
                            <field name="transaction_type"/>
                            <field name="facility_code"/>
                            <field name="program_id"/>
                            <field name="adjustment_reason"/>
                        </group>
                        <group>
                            <field name="elmis_orderable_id"/>
                            <field name="lot_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="transaction_date"/>
                        </group>
                    </group>
                    <group string="Odoo Source">
                        <group>
                            <field name="event_source_label"/>
                            <field name="movement_side_label"/>
                            <field name="prescription_ref"/>
                            <field name="consumption_mode"/>
                            <field name="dispensed_product_id"/>
                            <field name="dispensed_lot_id"/>
                            <field name="dispensed_quantity"/>
                            <field name="dispensed_uom_id"/>
                            <field name="source_bulk_product_id"/>
                            <field name="source_bulk_lot_id"/>
                            <field name="prepack_conversion_factor"/>
                        </group>
                        <group string="Source Records">
                            <field name="source_sale_order_line_id"/>
                            <field name="source_stock_scrap_id"/>
                            <field name="stock_scrap_side"/>
                            <field name="source_stock_move_id"/>
                            <field name="source_stock_move_line_id"/>
                            <field name="stock_move_line_side"/>
                        </group>
                    </group>
                    <group string="Delivery">
                        <group>
                            <field name="created_at"/>
                            <field name="sent_at"/>
                            <field name="delivered_at"/>
                            <field name="attempt_count"/>
                        </group>
                        <group>
                            <field name="error_message" placeholder="No delivery error recorded."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="elmis_outbox_dlq_view_tree" model="ir.ui.view">
        <field name="name">elmis.outbox.dlq.view.tree</field>
        <field name="model">elmis.outbox</field>
        <field name="arch" type="xml">
            <tree string="Failed Integration Events" create="false" edit="false" delete="false"
                  class="o_elmis_workspace_list o_elmis_integration_event_list o_elmis_dlq_list"
                  decoration-danger="status == 'DLQ'">
                <field name="created_at" string="Created"/>
                <field name="status" widget="badge" decoration-danger="status == 'DLQ'"/>
                <field name="message_id" optional="hide"/>
                <field name="transaction_type" string="Type"/>
                <field name="event_source_label" string="Workflow"/>
                <field name="movement_side_label" string="Movement"/>
                <field name="facility_code" string="Facility"/>
                <field name="program_id"/>
                <field name="prescription_ref"/>
                <field name="elmis_orderable_id" string="Product"/>
                <field name="lot_id" string="Batch"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="adjustment_reason" string="Reason"/>
                <field name="source_sale_order_line_id" optional="hide"/>
                <field name="source_stock_scrap_id" optional="hide"/>
                <field name="stock_scrap_side" optional="hide"/>
                <field name="source_stock_move_id" optional="hide"/>
                <field name="source_stock_move_line_id" optional="hide"/>
                <field name="stock_move_line_side" optional="hide"/>
                <field name="consumption_mode" optional="hide"/>
                <field name="dispensed_product_id" optional="hide"/>
                <field name="dispensed_lot_id" optional="hide"/>
                <field name="dispensed_quantity" optional="hide"/>
                <field name="attempt_count" string="Attempts"/>
                <field name="sent_at" optional="hide"/>
                <field name="error_message" string="Last Error"/>
            </tree>
        </field>
    </record>

    <record id="elmis_outbox_view_search" model="ir.ui.view">
        <field name="name">elmis.outbox.view.search</field>
        <field name="model">elmis.outbox</field>
        <field name="arch" type="xml">
            <search string="eLMIS Outbox">
                <field name="message_id"/>
                <field name="facility_code"/>
                <field name="prescription_ref"/>
                <field name="elmis_orderable_id"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'PENDING')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'FAILED')]"/>
                <filter name="dlq" string="DLQ" domain="[('status', '=', 'DLQ')]"/>
                <filter name="delivered" string="Delivered" domain="[('status', '=', 'DELIVERED')]"/>
                <separator/>
                <filter name="retryable" string="Retryable" domain="[('status', 'in', ['PENDING', 'FAILED'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'transaction_type'}"/>
                    <filter name="group_facility" string="Facility" context="{'group_by': 'facility_code'}"/>
                    <filter name="group_program" string="Program" context="{'group_by': 'program_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_elmis_outbox" model="ir.actions.act_window">
        <field name="name">Integration Events</field>
        <field name="res_model">elmis.outbox</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="elmis_outbox_view_search"/>
        <field name="context">{'search_default_retryable': 1}</field>
    </record>

    <record id="action_elmis_outbox_dlq" model="ir.actions.act_window">
        <field name="name">Failed Integration Events</field>
        <field name="res_model">elmis.outbox</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="elmis_outbox_dlq_view_tree"/>
        <field name="search_view_id" ref="elmis_outbox_view_search"/>
        <field name="domain">[('status', '=', 'DLQ')]</field>
        <field name="context">{'search_default_dlq': 1}</field>
    </record>

    <record id="action_elmis_outbox_drain_pending" model="ir.actions.server">
        <field name="name">Submit Pending eLMIS Outbox</field>
        <field name="model_id" ref="model_elmis_outbox"/>
        <field name="binding_model_id" ref="model_elmis_outbox"/>
        <field name="state">code</field>
        <field name="code">action = model.action_drain_pending_to_elmis()</field>
    </record>

    <record id="action_elmis_outbox_retry_selected" model="ir.actions.server">
        <field name="name">Retry Selected eLMIS Events</field>
        <field name="model_id" ref="model_elmis_outbox"/>
        <field name="binding_model_id" ref="model_elmis_outbox"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_submit_to_elmis()</field>
    </record>

    <record id="action_elmis_outbox_mark_dlq" model="ir.actions.server">
        <field name="name">Move Selected eLMIS Events to DLQ</field>
        <field name="model_id" ref="model_elmis_outbox"/>
        <field name="binding_model_id" ref="model_elmis_outbox"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_mark_dlq()</field>
    </record>

    <record id="action_elmis_outbox_reset_pending" model="ir.actions.server">
        <field name="name">Reopen Selected eLMIS Events for Retry</field>
        <field name="model_id" ref="model_elmis_outbox"/>
        <field name="binding_model_id" ref="model_elmis_outbox"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_reset_to_pending()</field>
    </record>

    <menuitem
        id="menu_elmis_outbox"
        name="Integration Events"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_elmis_outbox"
        sequence="82"
        groups="stock.group_stock_manager"/>

    <menuitem
        id="menu_elmis_outbox_dlq"
        name="Failed Integration Events"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_elmis_outbox_dlq"
        sequence="83"
        groups="stock.group_stock_manager"/>
</odoo>
